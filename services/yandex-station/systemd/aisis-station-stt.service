[Unit]
Description=AISIS streaming speech gateway to existing Wyoming recognizer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/xp/aisis/services/yandex-station/code
EnvironmentFile=%h/.config/aisis/runtime.env
# The local wyoming-whisper's offload control socket (wyoming_whisper_offload.py): /healthz/asr gives no verdict while it is unloaded or lent.
# Declares that AISIS_WYOMING_URI in runtime.env is that local recognizer; remove it if the URI points elsewhere.
Environment=AISIS_WHISPER_CTL_SOCKET=%t/vram-offload/wyoming-whisper.sock
ExecStart=%h/.local/share/aisis/venv/bin/python %h/xp/aisis/services/yandex-station/code/stt_wyoming.py
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=10
UMask=0077

[Install]
WantedBy=default.target
