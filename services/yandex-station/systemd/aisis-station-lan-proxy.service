[Unit]
Description=aisis quasar-server LAN proxy (192.168.0.56:31116 -> 127.0.0.1:31116, ALLOWED_PEERS only)
After=network-online.target docker.service

[Service]
# ALLOWED_PEERS=<Home Assistant address, comma separated IPs/CIDRs> (the proxy refuses to start without it; services/yandex-station/README.md)
EnvironmentFile=%h/.config/aisis/lan-proxy.env
ExecStart=%h/.local/share/aisis/venv/bin/python %h/xp/aisis/services/yandex-station/code/quasar_lan_proxy.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
